```gitignore
# =========================================================
# ENVIRONMENT & SECRETS
# =========================================================
.env
.env.*
!.env.example

backend/.env
backend/.env.*

# =========================================================
# FIREBASE / GOOGLE CLOUD CREDENTIALS
# =========================================================
serviceAccountKey.json
firebase-service-account.json
firebase-adminsdk-*.json
*-firebase-adminsdk-*.json
service-account.json
credentials.json
google-credentials.json

# Firebase local configuration/cache
.firebase/

# =========================================================
# PRIVATE KEYS / CERTIFICATES / SIGNING KEYS
# =========================================================
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore

cookapp-release-key.jks

# =========================================================
# NODE.JS / BACKEND
# =========================================================
node_modules/
backend/node_modules/

npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

*.tsbuildinfo

# Node build / coverage
dist/
backend/dist/
coverage/
.nyc_output/

# =========================================================
# FLUTTER / DART
# =========================================================
.dart_tool/
.packages
.pub/
.pub-cache/
.flutter-plugins
.flutter-plugins-dependencies

**/doc/api/
**/ios/Flutter/.last_build_id

build/
coverage/

# Flutter generated files
**/generated_plugin_registrant.dart

# Symbolication / obfuscation
app.*.symbols
app.*.map.json

# =========================================================
# ANDROID
# =========================================================
.gradle/
android/.gradle/

android/local.properties
android/app/build/
android/app/debug/
android/app/profile/
android/app/release/

android/key.properties

# Android generated files
**/android/**/GeneratedPluginRegistrant.java

# =========================================================
# IOS / XCODE
# =========================================================
ios/Pods/
ios/.symlinks/
ios/Flutter/

**/ios/**/xcuserdata/
**/ios/**/DerivedData/

**/ios/**/*.mode1v3
**/ios/**/*.mode2v3
**/ios/**/*.moved-aside
**/ios/**/*.pbxuser
**/ios/**/*.perspectivev3

ios/Runner/GeneratedPluginRegistrant.*

# =========================================================
# MACOS
# =========================================================
**/macos/Flutter/GeneratedPluginRegistrant.swift
**/macos/Flutter/ephemeral/
**/xcuserdata/

# =========================================================
# WINDOWS
# =========================================================
**/windows/flutter/generated_plugin_registrant.cc
**/windows/flutter/generated_plugin_registrant.h
**/windows/flutter/generated_plugins.cmake

# =========================================================
# LINUX
# =========================================================
**/linux/flutter/generated_plugin_registrant.cc
**/linux/flutter/generated_plugin_registrant.h
**/linux/flutter/generated_plugins.cmake

# =========================================================
# IDEs
# =========================================================
.idea/
*.iml
*.ipr
*.iws

.vscode/
.vscode/*

# =========================================================
# OS FILES
# =========================================================
.DS_Store
Thumbs.db

# =========================================================
# LOGS / TEMPORARY FILES
# =========================================================
*.log
*.class
*.pyc
*.swp
*.tmp

# =========================================================
# MISCELLANEOUS
# =========================================================
.atom/
.build/
.buildlog/
.history/
.svn/
.swiftpm/
migrate_working_dir/

# =========================================================
# PYTHON
# =========================================================
__pycache__/
.venv/
venv/

# =========================================================
# GENERATED / LOCAL FILES
# =========================================================
*.lock
*.seed
*.pid
*.pid.lock
*.tgz

# =========================================================
# LOCAL SECRET / CONFIG FILES
# =========================================================
secrets.json
secret.json
secrets.txt
passwords.txt
config.local.json
config.production.json
```
